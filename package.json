{
  "name": "english-chat-school",
  "private": true,
  "version": "1.0.0",
  "description": "Age-leveled English chat school with 100,000 five-choice questions per level.",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "bundle:engine": "npx esbuild src/engine/chatTurns.ts --bundle --platform=node --format=esm --outfile=scripts/_chatTurns.bundle.mjs && npx esbuild src/engine/topics.ts --bundle --platform=node --format=esm --outfile=scripts/_topics.bundle.mjs",
    "bundle:doctor": "npx esbuild src/engine/doctorTurns.ts --bundle --platform=node --format=esm --outfile=scripts/_doctorTurns.bundle.mjs",
    "bundle:female": "npx esbuild src/engine/femaleTurns.ts --bundle --platform=node --format=esm --outfile=scripts/_femaleTurns.bundle.mjs",
    "bundle:app": "npx esbuild src/main.tsx --bundle --format=esm --platform=browser --jsx=automatic --outfile=dist/app.js",
    "regen:ages": "npm run bundle:engine && node scripts/regen-english-ages.mjs",
    "regen:doctor": "npm run bundle:doctor && node scripts/regen-doctor-categories.mjs",
    "regen:female": "npm run bundle:female && node scripts/regen-doctor-female.mjs",
    "check:unique": "npm run bundle:engine && node scripts/check-unique-quick.mjs",
    "export:csv": "node scripts/export-csv.mjs",
    "export:english": "node scripts/export-csv.mjs english",
    "export:doctor": "npm run regen:doctor",
    "export:ages": "node scripts/export-english-age.mjs",
    "export:ages-all": "node scripts/export-english-age.mjs all"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
