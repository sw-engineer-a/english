{
  "name": "english-chat-school",
  "private": true,
  "version": "1.0.0",
  "description": "Age-leveled English chat school with 100,000 five-choice questions per level.",
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "export:csv": "node scripts/export-csv.mjs",
    "export:english": "node scripts/export-csv.mjs english",
    "export:doctor": "node scripts/export-csv.mjs doctor",
    "export:ages-6-8": "node scripts/export-english-age.mjs 6-8",
    "export:ages-all": "node scripts/export-english-age.mjs all"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
